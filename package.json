{
  "name": "kotlin-nav",
  "displayName": "Kotlin Nav",
  "description": "Instant Go to Definition for Kotlin — regex-based, zero LSP overhead",
  "version": "0.1.0",
  "publisher": "kotlin-nav",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "kotlin",
    "navigation",
    "go to definition",
    "android",
    "compose"
  ],
  "activationEvents": [
    "onLanguage:kotlin",
    "workspaceContains:**/*.kt",
    "onView:kotlinNav.findUsages"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "kotlinNavPanel",
          "title": "Find Usages",
          "icon": "media/find-usages.svg"
        }
      ]
    },
    "views": {
      "kotlinNavPanel": [
        {
          "id": "kotlinNav.findUsages",
          "name": "Find Usages",
          "type": "tree"
        }
      ]
    },
    "keybindings": [
      {
        "command": "kotlin-nav.findUsages",
        "key": "alt+f7",
        "mac": "alt+f7",
        "when": "editorTextFocus && (editorLangId == kotlin || editorLangId == java)"
      },
      {
        "command": "kotlin-nav.goToTest",
        "key": "alt+shift+t",
        "mac": "alt+shift+t",
        "when": "editorTextFocus && (editorLangId == kotlin || editorLangId == java)"
      }
    ],
    "commands": [
      {
        "command": "kotlin-nav.reindex",
        "title": "Kotlin Nav: Re-index workspace",
        "category": "Kotlin Nav"
      },
      {
        "command": "kotlin-nav.copyFqn",
        "title": "Kotlin Nav: Copy FQN",
        "category": "Kotlin Nav"
      },
      {
        "command": "kotlin-nav.findUsages",
        "title": "Find Usages",
        "category": "Kotlin Nav",
        "icon": "$(search)"
      },
      {
        "command": "kotlin-nav.findUsages.toggleTests",
        "title": "Tests: Showing — click to hide",
        "category": "Kotlin Nav",
        "icon": "$(beaker)"
      },
      {
        "command": "kotlin-nav.findUsages.showTests",
        "title": "Tests: Hidden — click to show",
        "category": "Kotlin Nav",
        "icon": "$(circle-slash)"
      },
      {
        "command": "kotlin-nav.findUsages.togglePreviews",
        "title": "Previews: Showing — click to hide",
        "category": "Kotlin Nav",
        "icon": "$(eye)"
      },
      {
        "command": "kotlin-nav.findUsages.showPreviews",
        "title": "Previews: Hidden — click to show",
        "category": "Kotlin Nav",
        "icon": "$(eye-closed)"
      },
      {
        "command": "kotlin-nav.goToTest",
        "title": "Go to Test/Implementation",
        "category": "Kotlin Nav"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "kotlin-nav.findUsages.toggleTests",
          "when": "view == kotlinNav.findUsages && kotlinNav.findUsages.showTests",
          "group": "navigation@1"
        },
        {
          "command": "kotlin-nav.findUsages.showTests",
          "when": "view == kotlinNav.findUsages && !kotlinNav.findUsages.showTests",
          "group": "navigation@1"
        },
        {
          "command": "kotlin-nav.findUsages.togglePreviews",
          "when": "view == kotlinNav.findUsages && kotlinNav.findUsages.showPreviews",
          "group": "navigation@2"
        },
        {
          "command": "kotlin-nav.findUsages.showPreviews",
          "when": "view == kotlinNav.findUsages && !kotlinNav.findUsages.showPreviews",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "kotlin-nav.findUsages",
          "when": "editorTextFocus && (editorLangId == kotlin || editorLangId == java)",
          "group": "navigation@8"
        },
        {
          "command": "kotlin-nav.goToTest",
          "when": "editorTextFocus && (editorLangId == kotlin || editorLangId == java)",
          "group": "navigation@9"
        },
        {
          "command": "kotlin-nav.copyFqn",
          "when": "editorLangId == kotlin",
          "group": "navigation@10"
        }
      ]
    },
    "languages": [
      {
        "id": "kotlin",
        "extensions": [
          ".kt",
          ".kts"
        ],
        "aliases": [
          "Kotlin",
          "kotlin"
        ]
      }
    ],
    "configuration": {
      "title": "Kotlin Nav",
      "properties": {
        "kotlinNav.excludePatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/build/**",
            "**/.gradle/**",
            "**/generated/**",
            "**/.idea/**"
          ],
          "description": "Glob patterns excluded from indexing."
        },
        "kotlinNav.maxIndexedFiles": {
          "type": "number",
          "default": 10000,
          "description": "Hard cap on the number of .kt files indexed."
        },
        "kotlinNav.concurrency": {
          "type": "number",
          "default": 20,
          "description": "Number of files read in parallel during initial scan."
        },
        "kotlinNav.parserWorkers": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "maximum": 8,
          "description": "Number of Node.js worker threads used for parallel Kotlin parsing."
        },
        "kotlinNav.excludeFromReferences": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "markdownDescription": "Glob patterns excluded from **Find All References** results. Matched files are still indexed (Go to Definition still works inside them) but are hidden from reference results.\n\nExample:\n```json\n[\n  \"**/src/test*/**\",\n  \"**/src/savedAndroidTest*/**\",\n  \"**/src/sharedTest*/**\",\n  \"**/src/debug/**/*Preview.kt\"\n]\n```"
        },
        "kotlinNav.testSourceSets": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "markdownDescription": "Path segments identifying test source sets. **Go to Definition** skips results inside these paths when navigating from main source, preventing accidental jumps into mock or test-only files."
        },
        "kotlinNav.smartNavigation": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "When **Cmd+Click** (or F12) lands on a declaration site, redirect to **Find All References** instead of navigating to self. Disable if you find this behaviour unexpected."
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "vscode:prepublish": "node esbuild.js --production",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/picomatch": "^4.0.2",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.9",
    "@vscode/test-electron": "^2.3.8",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "picomatch": "^4.0.4"
  }
}
