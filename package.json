{
  "name": "kotlin-jump",
  "displayName": "Kotlin Jump",
  "description": "Fast Kotlin & Java navigation — Go to Definition, Find Usages, Go to Implementation. No language server needed.",
  "version": "0.2.3",
  "publisher": "elumine",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/elumine-dev/kotlin-jump"
  },
  "homepage": "https://elumine.ca",
  "bugs": {
    "url": "https://github.com/elumine-dev/kotlin-jump/issues"
  },
  "sponsor": {
    "url": "https://github.com/sponsors/elumine-dev"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "kotlin",
    "android",
    "navigation",
    "go to definition",
    "find usages",
    "go to implementation",
    "jetpack compose",
    "java",
    "gradle",
    "intellij"
  ],
  "galleryBanner": {
    "color": "#7F52FF",
    "theme": "dark"
  },
  "activationEvents": [
    "onLanguage:kotlin",
    "workspaceContains:**/*.kt",
    "onView:kotlinJump.findUsages"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "kotlinJumpPanel",
          "title": "Find Usages",
          "icon": "media/find-usages.svg"
        }
      ]
    },
    "views": {
      "kotlinJumpPanel": [
        {
          "id": "kotlinJump.findUsages",
          "name": "Find Usages",
          "type": "tree"
        }
      ]
    },
    "keybindings": [
      {
        "command": "kotlin-jump.findUsages",
        "key": "alt+f7",
        "mac": "alt+f7",
        "when": "editorTextFocus && (editorLangId == kotlin || editorLangId == java)"
      },
      {
        "command": "kotlin-jump.goToTest",
        "key": "alt+shift+t",
        "mac": "alt+shift+t",
        "when": "editorTextFocus && (editorLangId == kotlin || editorLangId == java)"
      }
    ],
    "commands": [
      {
        "command": "kotlin-jump.reindex",
        "title": "Kotlin Jump: Re-index workspace",
        "category": "Kotlin Jump"
      },
      {
        "command": "kotlin-jump.copyFqn",
        "title": "Kotlin Jump: Copy FQN",
        "category": "Kotlin Jump"
      },
      {
        "command": "kotlin-jump.findUsages",
        "title": "Find Usages",
        "category": "Kotlin Jump",
        "icon": "$(search)"
      },
      {
        "command": "kotlin-jump.findUsages.toggleTests",
        "title": "Tests: Showing — click to hide",
        "category": "Kotlin Jump",
        "icon": "$(beaker)"
      },
      {
        "command": "kotlin-jump.findUsages.showTests",
        "title": "Tests: Hidden — click to show",
        "category": "Kotlin Jump",
        "icon": "$(circle-slash)"
      },
      {
        "command": "kotlin-jump.findUsages.togglePreviews",
        "title": "Previews: Showing — click to hide",
        "category": "Kotlin Jump",
        "icon": "$(eye)"
      },
      {
        "command": "kotlin-jump.findUsages.showPreviews",
        "title": "Previews: Hidden — click to show",
        "category": "Kotlin Jump",
        "icon": "$(eye-closed)"
      },
      {
        "command": "kotlin-jump.goToTest",
        "title": "Go to Test/Implementation",
        "category": "Kotlin Jump"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "kotlin-jump.findUsages.toggleTests",
          "when": "view == kotlinJump.findUsages && kotlinJump.findUsages.showTests",
          "group": "navigation@1"
        },
        {
          "command": "kotlin-jump.findUsages.showTests",
          "when": "view == kotlinJump.findUsages && !kotlinJump.findUsages.showTests",
          "group": "navigation@1"
        },
        {
          "command": "kotlin-jump.findUsages.togglePreviews",
          "when": "view == kotlinJump.findUsages && kotlinJump.findUsages.showPreviews",
          "group": "navigation@2"
        },
        {
          "command": "kotlin-jump.findUsages.showPreviews",
          "when": "view == kotlinJump.findUsages && !kotlinJump.findUsages.showPreviews",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "kotlin-jump.findUsages",
          "when": "editorTextFocus && (editorLangId == kotlin || editorLangId == java)",
          "group": "navigation@8"
        },
        {
          "command": "kotlin-jump.goToTest",
          "when": "editorTextFocus && (editorLangId == kotlin || editorLangId == java)",
          "group": "navigation@9"
        },
        {
          "command": "kotlin-jump.copyFqn",
          "when": "editorLangId == kotlin",
          "group": "navigation@10"
        }
      ]
    },
    "languages": [
      {
        "id": "kotlin",
        "extensions": [
          ".kt",
          ".kts"
        ],
        "aliases": [
          "Kotlin",
          "kotlin"
        ]
      }
    ],
    "configuration": {
      "title": "Kotlin Jump",
      "properties": {
        "kotlinJump.excludePatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/build/**",
            "**/.gradle/**",
            "**/generated/**",
            "**/.idea/**"
          ],
          "description": "Glob patterns excluded from indexing."
        },
        "kotlinJump.maxIndexedFiles": {
          "type": "number",
          "default": 10000,
          "description": "Hard cap on the number of .kt files indexed."
        },
        "kotlinJump.concurrency": {
          "type": "number",
          "default": 20,
          "description": "Number of files read in parallel during initial scan."
        },
        "kotlinJump.parserWorkers": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "maximum": 8,
          "description": "Number of Node.js worker threads used for parallel Kotlin parsing."
        },
        "kotlinJump.excludeFromReferences": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Glob patterns excluded from **Find All References** results. Matched files are still indexed (Go to Definition still works inside them) but are hidden from reference results.\n\nExample:\n```json\n[\n  \"**/src/test*/**\",\n  \"**/src/savedAndroidTest*/**\",\n  \"**/src/sharedTest*/**\",\n  \"**/src/debug/**/*Preview.kt\"\n]\n```"
        },
        "kotlinJump.testSourceSets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Path segments identifying test source sets. **Go to Definition** skips results inside these paths when navigating from main source, preventing accidental jumps into mock or test-only files."
        },
        "kotlinJump.smartNavigation": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "When **Cmd+Click** (or F12) lands on a declaration site, redirect to **Find All References** instead of navigating to self. Disable if you find this behaviour unexpected."
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "vscode:prepublish": "node esbuild.js --production",
    "release:notes": "./.publish --notes-only",
    "release:prepare": "./.publish",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vscode-test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/picomatch": "^4.0.2",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.9",
    "@vscode/test-electron": "^2.3.8",
    "esbuild": "^0.20.0",
    "husky": "^9.1.7",
    "typescript": "^5.3.3",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "picomatch": "^4.0.4"
  }
}
