<?xml version="1.0" encoding="utf-8"?>
<!-- KJ-021 fixture — usages res→res :
     android:text="@string/banner_caption"   → compte comme usage (1)
     tools:text="@string/legacy_subtitle"    → NE compte PAS (namespace tools)
     android:background="@color/banner_backdrop" → compte comme usage (1) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:background="@color/banner_backdrop">

    <TextView
        android:text="@string/banner_caption"
        tools:text="@string/legacy_subtitle" />

    <!-- KJ-029 fixture — usages res→res :
         <include layout=…>           → keeps view_kj_included alive
         app:menu=…                   → keeps menu_kj_main alive
         tools:layout=…               → does NOT keep view_kj_tools_only alive -->
    <include layout="@layout/view_kj_included" />

    <BottomNavigationView
        xmlns:app="http://schemas.android.com/apk/res-auto"
        app:menu="@menu/menu_kj_main" />

    <fragment tools:layout="@layout/view_kj_tools_only" />

    <!-- KJ-032 fixture — a custom view named by fully qualified name keeps
         its Kotlin class alive with no call site anywhere in the code. -->
    <com.example.kj.g5deadweight.GhostCustomView
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- KJ-031 fixture — the two reference forms only this detector reads:
         style="@style/…"     keeps a dotted style alive
         ?attr/…              keeps an attribute alive through the theme -->
    <Button
        style="@style/Widget.Kj.Button"
        android:background="?attr/kjAccent" />

</LinearLayout>
