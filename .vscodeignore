.vscode/**
.github/**
src/**
test/**
doc/**
.gitignore
.vscodeignore
.publish
.release-preview.md
.release-preview.whats-new.json
.vscode-test.mjs
tsconfig.json
vitest.config.ts
esbuild.js
publish.sh
.husky/**
.kotlin-jump-dev-mode
.idea/**
.claude/**
ANDROID-SETUP.md
CLAUDE.md
# Any other root-level note stays local. Listing them one by one meant the next
# working note shipped to the Marketplace: "next thing to do.md" made it into
# the 1.42.1 VSIX before this rule existed.
*.md
!README.md
!CHANGELOG.md
**/*.map
**/*.wasm
*.vsix
node_modules/**

# Static media not used at runtime
media/logo-*.png
media/logo.svg
media/icon-v1.*
media/icon.svg
media/README.txt
media/Demo.gif
media/Demo-original.gif
media/kotlin-jump-infographic.png
media/walkthrough/**
media/perf/**
media/ax-debug-harvest/**

# Demo recording tooling — DEV ONLY, never ship
scripts/**
dist/demo/**
dist/scripts/**
tmp-demo-e2e/**
tmp-demo-frames/**

# Unrelated tool artifacts that land in the repo root at dev time (Firebase
# CLI, ruvector/ruflo MCP, Playwright MCP session recordings). Not part of
# the extension; vsce packages the working tree regardless of .gitignore,
# so these need an explicit entry here too or they ship in the VSIX.
firebase-debug.log
ruvector.db
.playwright-mcp/**

# assets/demos/ : rien n'embarque par défaut. La liste nominative
# d'exclusions laissait passer chaque nouvelle demo (158 MB de VSIX le
# 25/07) : on exclut TOUT et on ré-inclut les seuls webp que le runtime
# consomme (walkthrough + What's New). README/CHANGELOG chargent le reste
# via raw.githubusercontent.com directement.
assets/demos/**
!assets/demos/ai-assistant.webp
!assets/demos/android-run.webp
!assets/demos/code-lens.webp
!assets/demos/find-usages-test-filter.webp
!assets/demos/go-to-definition.webp
!assets/demos/inlay-hints.webp
!assets/demos/lib-jar-coroutines.webp
!assets/demos/navigation-history.webp
!assets/demos/string-resource-folding.webp
!assets/demos/test-nav.webp
!assets/demos/vector-preview.webp
!assets/demos/welcome.webp
