#!/bin/bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT_DIR"

VERSION="$(node -p "require('./package.json').version")"
MODEL="${CLAUDE_PUBLISH_MODEL:-sonnet}"
MAX_BUDGET_USD="${CLAUDE_PUBLISH_MAX_BUDGET_USD:-1}"
LOCKFILE_NPM="${CLAUDE_PUBLISH_LOCKFILE_NPM:-npx -y npm@10}"
BASE_REF=""
VERSION_ARG=""
DRY_RUN=0
NOTES_ONLY=0
SKIP_NOTES=0
STAGE=0
COMMIT=0
TAG=0
PUSH=0

usage() {
  cat <<'EOF'
Usage: ./.publish [options]

Prepare a release with deterministic verification and Claude-assisted changelog drafting.

Options:
  --version <x.y.z>  Use this version for the release; writes package.json and syncs README.md unless --dry-run is used
  --base <git-ref>   Compare against this ref instead of auto-detecting
  --dry-run          Print the generated changelog section without writing it
  --notes-only       Update CHANGELOG.md only; skip tests/build/package
  --skip-notes       Skip Claude changelog drafting and only run verification/package
  --stage            Stage current changes with git add -A
  --commit           Stage current changes if needed, then create the release commit
  --tag              Create git tag v<version>; implies --commit
  --push             Push current branch and tags to origin; implies --tag
  --model <model>    Claude model alias or full model name (default: sonnet)
  -h, --help         Show this help

Environment:
  CLAUDE_PUBLISH_MODEL            Override the Claude model
  CLAUDE_PUBLISH_MAX_BUDGET_USD   Max Claude spend for the drafting step (default: 1)
  CLAUDE_PUBLISH_LOCKFILE_NPM     Command used to refresh package-lock.json for CI parity (default: npx -y npm@10)

Most explicit workflow:
  # 1. Preview release notes only
  ./.publish --dry-run --notes-only --version 0.2.1

  # 2. Write CHANGELOG.md, sync README.md, and set package.json version
  ./.publish --notes-only --version 0.2.1

  # 3. Run tests, build, and create the VSIX without changing git state
  ./.publish --skip-notes

  # 4. Review and finish the release manually
  git status
  git diff
  git add -A
  git commit -m "chore: prepare v0.2.1 release"
  git tag v0.2.1
  git push origin <branch> --tags

Fast workflow:
  ./.publish --version 0.2.1 --tag

Fastest workflow:
  ./.publish --version 0.2.1 --push

When to use each:
  --dry-run --notes-only = preview release notes only
  --notes-only = write release notes only
  --skip-notes = verify/build/package without rewriting notes
  --version = set the release version + sync README.md + refresh package-lock.json
  --commit = prepare + commit
  --tag = prepare + commit + tag
  --push = prepare + commit + tag + push

Useful examples:
  ./.publish --base v0.2.0 --dry-run --notes-only
      Preview notes using a specific release base

  ./.publish --version 0.2.1 --commit
      Set the version, write notes, verify/package, and create the release commit
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --version)
      VERSION_ARG="${2:-}"
      shift 2
      ;;
    --base)
      BASE_REF="${2:-}"
      shift 2
      ;;
    --dry-run)
      DRY_RUN=1
      shift
      ;;
    --notes-only)
      NOTES_ONLY=1
      shift
      ;;
    --skip-notes)
      SKIP_NOTES=1
      shift
      ;;
    --stage)
      STAGE=1
      shift
      ;;
    --commit)
      COMMIT=1
      shift
      ;;
    --tag)
      TAG=1
      shift
      ;;
    --push)
      PUSH=1
      shift
      ;;
    --model)
      MODEL="${2:-}"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

need_cmd() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "Missing required command: $1" >&2
    exit 1
  fi
}

need_cmd git
need_cmd node
need_cmd npm

if [[ "$PUSH" -eq 1 ]]; then
  TAG=1
fi
if [[ "$TAG" -eq 1 ]]; then
  COMMIT=1
fi
if [[ "$COMMIT" -eq 1 ]]; then
  STAGE=1
fi

if [[ "$DRY_RUN" -eq 1 && ( "$STAGE" -eq 1 || "$COMMIT" -eq 1 || "$TAG" -eq 1 || "$PUSH" -eq 1 ) ]]; then
  echo "--dry-run cannot be combined with --stage, --commit, --tag, or --push." >&2
  exit 1
fi

if [[ "$SKIP_NOTES" -eq 1 && "$NOTES_ONLY" -eq 1 ]]; then
  echo "--skip-notes and --notes-only do not make sense together." >&2
  exit 1
fi

validate_version() {
  local version="$1"
  if [[ ! "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+([.-][0-9A-Za-z.-]+)?(\+[0-9A-Za-z.-]+)?$ ]]; then
    echo "Invalid version: $version" >&2
    exit 1
  fi
}

set_package_version() {
  local next_version="$1"
  node - "$next_version" <<'NODE'
const fs = require('fs');
const path = 'package.json';
const nextVersion = process.argv[2];
const pkg = JSON.parse(fs.readFileSync(path, 'utf8'));
pkg.version = nextVersion;
fs.writeFileSync(path, `${JSON.stringify(pkg, null, 2)}\n`);
NODE
}

sync_readme_version() {
  local next_version="$1"
  local status
  status="$(node - "$next_version" <<'NODE'
const fs = require('fs');
const path = 'README.md';
const version = process.argv[2];
let text = fs.readFileSync(path, 'utf8');
const original = text;

syncInstallCommandSection('VSIX');
syncInstallCommandSection('Build from source');

if (text !== original) {
  fs.writeFileSync(path, text);
  process.stdout.write('changed');
} else {
  process.stdout.write('unchanged');
}

function syncInstallCommandSection(title) {
  const sectionRe = new RegExp(`(### ${escapeRegex(title)}\\s*\\n)([\\s\\S]*?)(?=\\n### |\\n## |$)`);
  const match = text.match(sectionRe);
  if (!match) {
    throw new Error(`Could not find README section "${title}"`);
  }

  const body = match[2];
  let replacements = 0;
  const nextBody = body.replace(
    /code --install-extension kotlin-jump-(?:<version>|\*|[0-9][0-9A-Za-z.+-]*)\.vsix/g,
    () => {
      replacements += 1;
      return `code --install-extension kotlin-jump-${version}.vsix`;
    }
  );

  if (replacements === 0) {
    throw new Error(`Could not find a VSIX install command in README section "${title}"`);
  }

  text = text.replace(sectionRe, `$1${nextBody}`);
}

function escapeRegex(value) {
  return value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
}
NODE
)"

  if [[ "$status" == "changed" ]]; then
    echo "Synced README.md VSIX install commands to $next_version."
  else
    echo "README.md VSIX install commands already match $next_version."
  fi
}

sync_lockfile() {
  echo "Refreshing package-lock.json with CI-compatible npm..."
  ${LOCKFILE_NPM} install --package-lock-only --ignore-scripts
}

ensure_local_dependencies() {
  if [[ -x "node_modules/.bin/vitest" && -x "node_modules/.bin/vsce" && -x "node_modules/.bin/ovsx" ]]; then
    return
  fi

  echo "Installing local dependencies with npm ci..."
  npm ci
}

bump_version() {
  local current="$1" bump_type="$2"
  node -e "
    const [maj, min, pat] = '$current'.split('.').map(Number);
    if ('$bump_type' === 'minor') console.log(maj + '.' + (min + 1) + '.0');
    else console.log(maj + '.' + min + '.' + (pat + 1));
  "
}

preflight_check_tag() {
  # Abort BEFORE any work if the tag already exists. This prevents the "ran the
  # script twice and ended up with duplicate release commits" failure mode.
  # Only enforce when we are going to create a release artifact (commit/tag/push)
  # — `--notes-only` / `--dry-run` are intentionally exempt so you can still fix
  # typos in release notes after the tag has been pushed.
  local version="$1"
  local tag_name="v$version"
  local acting=0
  if [[ "$COMMIT" -eq 1 || "$TAG" -eq 1 || "$PUSH" -eq 1 ]]; then
    acting=1
  fi
  if [[ "$DRY_RUN" -eq 1 || "$NOTES_ONLY" -eq 1 || "$acting" -eq 0 ]]; then
    return 0
  fi

  if git rev-parse -q --verify "refs/tags/$tag_name" >/dev/null 2>&1; then
    echo "ERROR: Tag $tag_name already exists locally." >&2
    echo "       v$version is already released. To update release notes without" >&2
    echo "       creating a new tag/commit, use --notes-only." >&2
    exit 1
  fi
  if git ls-remote --tags origin "refs/tags/$tag_name" 2>/dev/null | grep -q "refs/tags/$tag_name"; then
    echo "ERROR: Tag $tag_name already exists on origin." >&2
    echo "       v$version is already released. To update release notes without" >&2
    echo "       creating a new tag/commit, use --notes-only." >&2
    exit 1
  fi
}

if [[ -n "$VERSION_ARG" ]]; then
  validate_version "$VERSION_ARG"
  VERSION="$VERSION_ARG"
  preflight_check_tag "$VERSION"
elif [[ -t 0 && "$DRY_RUN" -eq 0 && "$NOTES_ONLY" -eq 0 ]]; then
  echo "Current version: $VERSION"
  echo "  1) patch → $(bump_version "$VERSION" patch)"
  echo "  2) minor → $(bump_version "$VERSION" minor)"
  read -rp "Bump type [1/2]: " bump_choice
  case "$bump_choice" in
    1) VERSION="$(bump_version "$VERSION" patch)" ;;
    2) VERSION="$(bump_version "$VERSION" minor)" ;;
    *) echo "Invalid choice. Use --version x.y.z to set manually." >&2; exit 1 ;;
  esac
  VERSION_ARG="$VERSION"
  preflight_check_tag "$VERSION"
fi

if [[ "$DRY_RUN" -eq 0 ]]; then
  if [[ -n "$VERSION_ARG" ]]; then
    set_package_version "$VERSION_ARG"
  fi
  sync_readme_version "$VERSION"
fi

if [[ -n "$VERSION_ARG" && "$DRY_RUN" -eq 0 ]]; then
  sync_lockfile
fi

infer_base_ref() {
  if [[ -n "$BASE_REF" ]]; then
    printf '%s\n' "$BASE_REF"
    return
  fi

  local tag
  tag="$(git tag --sort=-version:refname | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$' | head -n 1 || true)"
  if [[ -n "$tag" ]]; then
    printf '%s\n' "$tag"
    return
  fi

  printf '%s\n' "HEAD"
}

BASE_REF="$(infer_base_ref)"

if ! git rev-parse --verify "$BASE_REF" >/dev/null 2>&1; then
  echo "Invalid base ref: $BASE_REF" >&2
  exit 1
fi

WORK_DIR="$(mktemp -d)"
trap 'rm -rf "$WORK_DIR"' EXIT

COMMIT_RANGE_FILE="$WORK_DIR/commit-range.txt"
WORKTREE_FILE="$WORK_DIR/worktree.txt"
PROMPT_FILE="$WORK_DIR/prompt.txt"
RAW_AI_FILE="$WORK_DIR/claude-raw.json"
STRUCTURED_FILE="$WORK_DIR/claude-structured.json"
SECTION_FILE="$WORK_DIR/changelog-section.md"

build_context() {
  # Paths that contain DEV-ONLY tooling (demo recording pipeline, marker
  # files, isolated docs). These are never shipped to users, so they must
  # not influence the user-facing release notes in any way. We pass them
  # as git pathspec exclusions to filter out commits/diffs/files that
  # touch ONLY these paths. (A commit that mixes shipped + dev-only
  # changes still shows up; the prompt rule below is the safety net.)
  local dev_only_excludes=(
    ':(exclude,glob)scripts/**'
    ':(exclude).kotlin-jump-dev-mode'
    ':(exclude)doc/demo-recording.md'
    ':(exclude,glob)media/demos/**'
  )

  {
    echo "Version: $VERSION"
    echo "Base ref: $BASE_REF"
    echo
    if [[ "$BASE_REF" == "HEAD" ]]; then
      echo "Release scope: working tree changes only."
      echo "Reason: no prior semver tag was found automatically."
    else
      echo "Release scope: committed changes since $BASE_REF plus current worktree changes."
    fi
    echo
    echo "Repository:"
    node - <<'NODE'
const pkg = require('./package.json');
const summary = {
  name: pkg.name,
  displayName: pkg.displayName,
  description: pkg.description,
  version: pkg.version,
  commands: (pkg.contributes?.commands ?? []).map(c => c.command),
  settings: Object.keys(pkg.contributes?.configuration?.properties ?? {}),
};
console.log(JSON.stringify(summary, null, 2));
NODE
    echo
    echo "Commits in scope (dev-only tooling paths and scopes filtered out):"
    if [[ "$BASE_REF" == "HEAD" ]]; then
      echo "- none (worktree-only mode)"
    else
      # Two-layer filter:
      # - Pathspec excludes (below) remove commits that touch ONLY dev-only paths.
      # - `--invert-grep --grep=...` removes commits whose subject uses a
      #   conventional-commit scope reserved for the dev-only demo pipeline:
      #   (demo), (demo-recorder). Mixed-file commits with these scopes also
      #   vanish, which protects the commit message itself from leaking into
      #   the prompt context.
      git log --no-merges \
        --invert-grep \
        --grep='^\(feat\|fix\|refactor\|chore\)(demo\b' \
        --grep='^\(feat\|fix\|refactor\|chore\)(demo-recorder\b' \
        --format='- %h %s' \
        "$BASE_REF..HEAD" -- . "${dev_only_excludes[@]}" || true
    fi
    echo
    echo "Committed diff stat in scope:"
    if [[ "$BASE_REF" == "HEAD" ]]; then
      echo "(none)"
    else
      git diff --stat "$BASE_REF..HEAD" -- . "${dev_only_excludes[@]}" || true
    fi
    echo
    echo "Committed changed files in scope:"
    if [[ "$BASE_REF" == "HEAD" ]]; then
      echo "(none)"
    else
      git diff --name-status "$BASE_REF..HEAD" -- . "${dev_only_excludes[@]}" || true
    fi
    echo
    echo "Current worktree status (dev-only paths filtered):"
    git status --short --untracked-files=all -- . "${dev_only_excludes[@]}" || true
    echo
    echo "Current staged diff stat:"
    git diff --cached --stat -- . "${dev_only_excludes[@]}" || true
    echo
    echo "Current unstaged diff stat:"
    git diff --stat -- . "${dev_only_excludes[@]}" || true
    echo
    echo "Current tracked diff patch:"
    # Only user-facing files go through the unfiltered diff. `.vscodeignore`
    # and `.publish` contain explicit references to the dev-only demo tooling
    # (paths, keywords like ffmpeg / screencapture / recorder-ext), so their
    # patches must not leak into the prompt — even though the prompt's HARD
    # EXCLUSIONS would reject them, defence-in-depth is cheap here.
    #
    # Also strip any `+`/`-` diff lines that mention the very specific
    # identifiers we reserved for the demo pipeline. This catches the
    # `demo:record` / `demo:workspace` scripts leaking via package.json,
    # or any other forbidden identifier that sneaked into a user-facing file.
    git diff -- package.json CHANGELOG.md README.md media/find-usages.svg 2>/dev/null \
      | grep -vE '^[+-][^+-].*(demo:record|demo:workspace|predemo:|scripts/demo|recorder-ext|\.kotlin-jump-dev-mode|KJ_DEMO|kotlinJumpDemo\.|kotlin-jump-demo-recorder)' \
      || true
    echo
    echo "Current top of CHANGELOG.md:"
    sed -n '1,80p' CHANGELOG.md
  } > "$COMMIT_RANGE_FILE"
}

render_prompt() {
  cat > "$PROMPT_FILE" <<EOF
You are writing release notes for a public GitHub release of a VS Code extension.

Rules:
- Use only the facts supplied below.
- Do not invent features, fixes, metrics, files, or links.
- Write for users deciding whether to install or update, not for maintainers reading a commit log.
- Lead with user value and real impact.
- Always explain why a change matters to the user.
- If a change is internal (CI, workflow, packaging, refactor), reframe it as a user benefit when accurate: reliability, stability, consistency, or release quality.
- If there are no functional changes to extension behavior, say that clearly in a Notes section.
- Do not include meaningless bullets like "Bumped version" or "Updated package.json".
- Do not list raw implementation details unless they materially help a user understand the release.
- Keep the tone concise, credible, and professional. No hype, no emojis, no fluff.
- Prefer section headings from this set when they fit: Improvements, Fixes, Notes, Packaging and docs.
- Use at most 3 sections unless the evidence strongly justifies more.
- Each bullet must stand on its own, mention impact, and start with a verb in past tense or present tense.
- Mention only changes that are actually evidenced by the supplied git/context data.
- Before finalizing each bullet, ask yourself: "Would a user care?" If not, rewrite it or omit it.

HARD EXCLUSIONS (must never appear in the output, even tangentially):
- Anything under \`scripts/demo/\`, \`scripts/demo/recorder-ext/\`, \`dist/demo/\`, or \`doc/demo-recording.md\`.
- The files \`.kotlin-jump-dev-mode\` or anything called "demo recorder", "demo recording",
  "recorder-ext", or "kotlinJumpDemo" / "KJ_DEMO_*".
- The screen-capture / WebP generation pipeline (ffmpeg, screencapture, @vscode/test-electron
  demo usage, Stage/Timeline/Overlay libraries).
- Any WebP demo assets under \`media/demos/\`.
These are internal maintainer tooling, never shipped to end-users, and must not be mentioned
in release notes, changelog, highlights, tagline, or summary. If git context still surfaces
any of them (e.g. because a commit mixed shipped and dev-only changes), ignore that portion
silently. Never summarise a release as "adds demo recording" or similar.

Return structured JSON with:
- summary: one short sentence
- tagline: one punchy phrase (max 8 words) capturing the release's key theme — no verbs, no fluff
- highlights: 2-3 top changes as cards, each with:
  - title: short label (max 5 words, noun phrase)
  - description: one sentence explaining the user benefit
  - kind: "feature" (brand-new capability), "improvement" (better existing feature), "fix" (bug fix), or "note" (non-behavioural)
- sections: array of objects with:
  - heading: short title case heading
  - bullets: 1-5 bullets

Do NOT emit "media" or "mediaAlt" fields on highlights. A maintainer wires those to recorded demo webps by hand after this step; the publish script preserves any existing media field when it matches a highlight title.

Context:

$(cat "$COMMIT_RANGE_FILE")
EOF
}

extract_structured_output() {
  node - "$RAW_AI_FILE" "$STRUCTURED_FILE" <<'NODE'
const fs = require('fs');
const [rawPath, outPath] = process.argv.slice(2);
const raw = fs.readFileSync(rawPath, 'utf8').trim();
let parsed = JSON.parse(raw);
let structured = parsed?.structured_output;
if (!structured && Array.isArray(parsed)) {
  for (let i = parsed.length - 1; i >= 0; i--) {
    const item = parsed[i];
    if (item && item.structured_output) {
      structured = item.structured_output;
      break;
    }
  }
}
if (!structured) {
  throw new Error('Claude output did not contain structured_output');
}

// Final safety net: even with path excludes + scope excludes + diff content
// filtering + HARD EXCLUSIONS in the prompt, if Claude still manages to
// mention any dev-only term in its output, we abort BEFORE writing it to
// CHANGELOG.md or media/whats-new.json. The user-visible release MUST NOT
// mention the demo recording pipeline.
const forbiddenTerms = [
  'scripts/demo', 'recorder-ext', 'kotlin-jump-demo-recorder',
  'kotlinJumpDemo', 'KJ_DEMO', '.kotlin-jump-dev-mode',
  'demo recording', 'demo recorder', 'demo pipeline',
  'screencapture', 'ffmpeg', 'webp demo', 'record demo',
];
const flat = JSON.stringify(structured).toLowerCase();
const hits = forbiddenTerms.filter(t => flat.includes(t.toLowerCase()));
if (hits.length > 0) {
  console.error(`ERROR: Claude's release notes contain forbidden dev-only terms:`);
  for (const h of hits) console.error(`   - ${h}`);
  console.error(`Refusing to write CHANGELOG.md / whats-new.json. Review prompt or context.`);
  process.exit(4);
}

fs.writeFileSync(outPath, JSON.stringify(structured, null, 2));
NODE
}

render_markdown_section() {
  node - "$VERSION" "$STRUCTURED_FILE" "$SECTION_FILE" <<'NODE'
const fs = require('fs');
const [version, jsonPath, outPath] = process.argv.slice(2);
const data = JSON.parse(fs.readFileSync(jsonPath, 'utf8'));
const headingOrder = new Map([
  ['Improvements', 0],
  ['Fixes', 1],
  ['Notes', 2],
  ['Packaging and docs', 3],
]);
const noisyBulletPatterns = [
  /^bumped version\b/i,
  /^updated package\.json\b/i,
  /^updated version\b/i,
  /^prepared release\b/i,
];
const lines = [`## ${version}`, '', data.summary.trim(), ''];
const sections = [...data.sections].sort((a, b) => {
  const aRank = headingOrder.get(String(a?.heading ?? '').trim()) ?? 99;
  const bRank = headingOrder.get(String(b?.heading ?? '').trim()) ?? 99;
  return aRank - bRank;
});
for (const section of sections) {
  if (!section || !section.heading || !Array.isArray(section.bullets) || section.bullets.length === 0) {
    continue;
  }
  const bullets = section.bullets
    .map(bullet => String(bullet).trim())
    .filter(text => text && !noisyBulletPatterns.some(pattern => pattern.test(text)));
  if (bullets.length === 0) {
    continue;
  }
  lines.push(`### ${section.heading.trim()}`);
  for (const text of bullets) {
    lines.push(`- ${text}`);
  }
  lines.push('');
}
fs.writeFileSync(outPath, `${lines.join('\n').trimEnd()}\n`);
NODE
}

update_changelog() {
  node - "$VERSION" "$SECTION_FILE" <<'NODE'
const fs = require('fs');
const [version, sectionPath] = process.argv.slice(2);
const path = 'CHANGELOG.md';
// Keep one trailing newline on the section so replacement leaves a blank line
// between the section we wrote and the next `## X.Y.Z` heading below it.
const section = fs.readFileSync(sectionPath, 'utf8').replace(/\s+$/, '') + '\n';
const text = fs.readFileSync(path, 'utf8');
const escaped = version.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
// NOTE: no `m` flag. Without it, `$` anchors to end-of-string (not end-of-line),
// so the regex correctly spans the full existing section until the next `## X.Y.Z`
// or the end of the file. With the `m` flag, `$` matched end-of-line, so running
// this script twice for the same version produced duplicated sections.
const re = new RegExp(`## ${escaped}[\\s\\S]*?(?=\\n## \\d+\\.\\d+\\.\\d+|$)`);
let next;
if (re.test(text)) {
  next = text.replace(re, section);
} else {
  next = text.replace(/^# Changelog\s*\n+/m, `# Changelog\n\n${section}\n`);
}
fs.writeFileSync(path, next.endsWith('\n') ? next : `${next}\n`);
NODE
}

render_whats_new() {
  node - "$VERSION" "$STRUCTURED_FILE" "$BASE_REF" <<'NODE'
const fs = require('fs');
const { execSync } = require('child_process');
const [version, jsonPath, baseRef] = process.argv.slice(2);
const data = JSON.parse(fs.readFileSync(jsonPath, 'utf8'));

// ── Merge-preserve: keep user-authored `media` / `mediaAlt` ──────────────
// When a highlight in the existing whats-new.json has the same title as one
// just drafted by Claude, copy its `media` / `mediaAlt` fields onto the new
// highlight. Lets a maintainer hand-wire a demo webp once and have it stick
// across re-drafts. Claude is now allowed to emit these fields too but is
// instructed not to (it doesn't know which webps were hand-recorded).
let priorByTitle = new Map();
try {
  const prior = JSON.parse(fs.readFileSync('media/whats-new.json', 'utf8'));
  for (const h of (prior.highlights || [])) {
    if (h && typeof h.title === 'string') priorByTitle.set(h.title, h);
  }
} catch {
  // First release (or prior file missing / malformed) — nothing to merge.
}

const mergedHighlights = (data.highlights || []).slice(0, 3).map(h => {
  const prev = priorByTitle.get(h.title);
  if (!prev) return h;
  return {
    ...h,
    ...(h.media    ? {}                                         : prev.media    ? { media:    prev.media    } : {}),
    ...(h.mediaAlt ? {}                                         : prev.mediaAlt ? { mediaAlt: prev.mediaAlt } : {}),
  };
});

// ── Auto-link new/modified demos to best-matching highlight ──────────────
// What happens without this: a maintainer records a new demo for a release
// (say, `suppress-hover.webp`), then forgets to wire it into the highlight
// card. The feature ships without its demo. This loop detects webps under
// `media/demos/` that were added OR modified in the release range and
// assigns each to the highlight whose title + description share the most
// tokens with the demo filename AND the demo's `.demo.ts` docblock.
//
// Scoring is Jaccard on lowercased alphanumeric tokens ≥ 3 chars, minus a
// small stopword list. Threshold = 0.15 — lenient enough for the
// `suppress-hover.webp` ↔ "@Suppress on hover" case (tokens "suppress" +
// "hover" overlap) but tight enough that unrelated demos don't get pinned.
// Every decision is logged so the maintainer can spot mismatches before
// publishing. A demo that fails to match is listed in a "consider hand-
// wiring" footer so no new demo silently falls through.
const STOPWORDS = new Set([
  'the', 'and', 'for', 'with', 'from', 'that', 'this', 'new', 'into',
  'your', 'out', 'get', 'has', 'have', 'via', 'but', 'now', 'any',
  'are', 'was', 'will', 'were', 'demo', 'kotlin', 'jump',
]);

function tokenize(s) {
  return new Set(
    String(s || '')
      .toLowerCase()
      .replace(/[^\w\s-]/g, ' ')
      .split(/[\s\-_]+/)
      .filter(t => t.length >= 3)
      .filter(t => !STOPWORDS.has(t)),
  );
}

function jaccard(a, b) {
  if (a.size === 0 || b.size === 0) return 0;
  let inter = 0;
  for (const x of a) if (b.has(x)) inter++;
  const union = new Set([...a, ...b]).size;
  return inter / union;
}

function newOrModifiedDemos(baseRef) {
  if (!baseRef || baseRef === 'HEAD') return [];
  let diff = '';
  try {
    diff = execSync(
      `git diff --name-status ${baseRef}..HEAD -- media/demos/`,
      { encoding: 'utf8' },
    );
  } catch {
    return [];
  }
  const demos = [];
  for (const line of diff.split('\n')) {
    if (!line.trim()) continue;
    const parts = line.split('\t');
    const status = parts[0];
    const path   = parts[parts.length - 1];
    if (!/\.webp$/.test(path))                    continue;
    if (!(status.startsWith('A') || status.startsWith('M'))) continue;
    const name = path.replace(/^media\/demos\//, '').replace(/\.webp$/, '');
    if (name.endsWith('-poster')) continue;
    demos.push({ status, name, path });
  }
  return demos;
}

function demoTokens(name) {
  const tokens = tokenize(name);
  // Augment with the leading JSDoc comment from the matching .demo.ts —
  // the captions and explanation in the file describe the feature better
  // than the filename alone.
  try {
    const src = fs.readFileSync(`scripts/demo/demos/${name}.demo.ts`, 'utf8');
    const doc = src.match(/\/\*\*([\s\S]*?)\*\//);
    if (doc) for (const t of tokenize(doc[1])) tokens.add(t);
  } catch { /* no .demo.ts (e.g. manual recording) → filename-only match */ }
  return tokens;
}

const demos = newOrModifiedDemos(baseRef);
const usedDemos = new Set();

// Any highlights that already have a media field (merge-preserved or
// Claude-emitted) stake a claim on that demo.
for (const h of mergedHighlights) {
  if (h.media) usedDemos.add(String(h.media).replace(/\.webp$/, ''));
}

const demoTokenMap = new Map(demos.map(d => [d.name, demoTokens(d.name)]));

for (const h of mergedHighlights) {
  if (h.media) continue;
  const titleTokens = new Set([...tokenize(h.title), ...tokenize(h.description || '')]);
  let best = null;
  for (const [demoName, dTokens] of demoTokenMap) {
    if (usedDemos.has(demoName)) continue;
    const score = jaccard(titleTokens, dTokens);
    if (score >= 0.15 && (!best || score > best.score)) {
      best = { name: demoName, score };
    }
  }
  if (best) {
    h.media    = `${best.name}.webp`;
    h.mediaAlt = h.title;
    usedDemos.add(best.name);
    process.stderr.write(
      `[whats-new] auto-linked media/demos/${best.name}.webp → "${h.title}" (jaccard=${best.score.toFixed(2)})\n`,
    );
  }
}

for (const d of demos) {
  if (usedDemos.has(d.name)) continue;
  process.stderr.write(
    `[whats-new] demo "${d.name}.webp" (${d.status}) did not match any highlight. ` +
    `To feature it, rename a highlight or hand-wire the "media" field in media/whats-new.json.\n`,
  );
}

// ── Final object + write ─────────────────────────────────────────────────
const whatsNew = {
  version,
  title: "What's New in Kotlin Jump",
  tagline: data.tagline || data.summary,
  summary: data.summary,
  highlights: mergedHighlights,
  sections: data.sections || [],
  links: {
    changelog: 'https://github.com/elumine-dev/kotlin-jump/blob/main/CHANGELOG.md',
    issues: 'https://github.com/elumine-dev/kotlin-jump/issues',
  },
};

fs.writeFileSync('media/whats-new.json', `${JSON.stringify(whatsNew, null, 2)}\n`);
NODE
}

draft_notes() {
  need_cmd claude

  build_context
  render_prompt

  claude -p \
    --model "$MODEL" \
    --max-budget-usd "$MAX_BUDGET_USD" \
    --output-format json \
    --json-schema '{"type":"object","properties":{"summary":{"type":"string"},"tagline":{"type":"string"},"highlights":{"type":"array","items":{"type":"object","properties":{"title":{"type":"string"},"description":{"type":"string"},"kind":{"type":"string","enum":["feature","improvement","fix","note"]},"media":{"type":"string"},"mediaAlt":{"type":"string"}},"required":["title","kind"],"additionalProperties":false},"minItems":1,"maxItems":3},"sections":{"type":"array","items":{"type":"object","properties":{"heading":{"type":"string"},"bullets":{"type":"array","items":{"type":"string"},"minItems":1,"maxItems":5}},"required":["heading","bullets"],"additionalProperties":false},"minItems":1,"maxItems":4}},"required":["summary","tagline","highlights","sections"],"additionalProperties":false}' \
    < "$PROMPT_FILE" > "$RAW_AI_FILE"

  extract_structured_output
  render_markdown_section

  if [[ "$DRY_RUN" -eq 1 ]]; then
    cat "$SECTION_FILE"
    return
  fi

  update_changelog
  render_whats_new

  # HARD GATE — validate the fresh whats-new.json before letting the
  # release commit be created. Anything suspicious (missing media, leaked
  # LLM chain-of-thought, wrong version, broken schema, oversized fields)
  # prints a precise error and exits non-zero, which aborts .publish
  # before any commit / tag / push. A corrupt whats-new.json must never
  # reach the Marketplace.
  if ! node "$ROOT_DIR/.github/scripts/validate-whats-new.mjs" --version "$VERSION"; then
    echo ""
    echo "✗ media/whats-new.json failed validation. Release aborted."
    echo "  Fix the issues listed above (by hand or by re-running Claude)"
    echo "  and re-run .publish."
    exit 1
  fi

  echo "Updated CHANGELOG.md and media/whats-new.json for $VERSION using Claude ($MODEL)."
  if [[ "$BASE_REF" == "HEAD" ]]; then
    echo "No prior semver tag was found, so the draft used worktree changes only."
    echo "Use ./.publish --base <git-ref> if you want release notes over a wider range."
  fi
}

check_walkthrough_coverage() {
  node - <<'NODE'
const fs = require('fs');
const pkg = require('./package.json');
const registered = new Set((pkg.contributes?.commands ?? []).map(c => c.command));
const walkthroughs = pkg.contributes?.walkthroughs ?? [];
let failed = false;
for (const wt of walkthroughs) {
  for (const step of (wt.steps ?? [])) {
    // Validate command: references in descriptions
    const refs = [...(step.description ?? '').matchAll(/command:([\w.-]+)/g)].map(m => m[1]);
    for (const cmd of refs) {
      if (cmd.startsWith('kotlin-jump.') || cmd.startsWith('kotlinJump.')) {
        if (!registered.has(cmd)) {
          console.error(`  Walkthrough step "${step.id}": unregistered command "${cmd}"`);
          failed = true;
        }
      }
    }
    // Validate media files exist
    const img = step.media?.image;
    if (img && !fs.existsSync(img)) {
      console.error(`  Walkthrough step "${step.id}": missing media file "${img}"`);
      failed = true;
    }
  }
}
if (failed) { console.error('Fix walkthrough before packaging.'); process.exit(1); }
else console.log('Walkthrough: OK');
NODE
}

check_no_demo_tooling_in_vsix() {
  # Safety net: make sure the dev-only demo recording pipeline never leaks
  # into a published VSIX. Runs AFTER packaging but BEFORE any git/tag/push.
  local forbidden_patterns=(
    "scripts/demo"
    "recorder-ext"
    "kotlin-jump-demo-recorder"
    ".kotlin-jump-dev-mode"
  )
  local vsix_file
  vsix_file="$(ls -t ./*.vsix 2>/dev/null | head -n 1 || true)"
  if [[ -z "$vsix_file" ]]; then
    echo "  (skipping isolation check — no VSIX found yet)"
    return 0
  fi
  local contents
  contents="$(unzip -l "$vsix_file" 2>/dev/null || true)"
  for pattern in "${forbidden_patterns[@]}"; do
    if echo "$contents" | grep -q "$pattern"; then
      echo "ERROR: forbidden pattern '$pattern' found inside $vsix_file." >&2
      echo "       Demo recording tooling must never ship. Fix .vscodeignore." >&2
      echo "       Offending entries:" >&2
      echo "$contents" | grep "$pattern" | head -5 | sed 's/^/         /' >&2
      exit 1
    fi
  done
  echo "  VSIX isolation check: OK (no demo tooling leaked)"
}

verify_release() {
  check_walkthrough_coverage
  ensure_local_dependencies

  echo "Running tests..."
  npm test

  echo "Building production..."
  node esbuild.js --production

  echo "Packaging..."
  npx @vscode/vsce package --no-dependencies
  check_no_demo_tooling_in_vsix
}

stage_release_changes() {
  echo "Staging current repo changes..."
  git add -A
}

commit_release() {
  local commit_message="chore: prepare v$VERSION release"
  if git diff --cached --quiet; then
    echo "No staged changes to commit. Skipping commit."
    return
  fi

  # Defence-in-depth: validate whats-new.json one last time RIGHT BEFORE
  # the commit. `draft_notes` runs validation after its own render step,
  # but a user-initiated `.publish --skip-notes` bypasses that path — the
  # committed file would still be a previous release's content. Catch
  # either case here so a malformed file never becomes a tagged commit.
  if ! node "$ROOT_DIR/.github/scripts/validate-whats-new.mjs" --version "$VERSION"; then
    echo ""
    echo "✗ media/whats-new.json failed validation at commit time. Release aborted."
    exit 1
  fi

  echo "Creating release commit..."
  git commit -m "$commit_message"
}

create_release_tag() {
  local tag_name="v$VERSION"
  if git rev-parse -q --verify "refs/tags/$tag_name" >/dev/null 2>&1; then
    echo "Tag already exists: $tag_name" >&2
    exit 1
  fi

  echo "Creating git tag $tag_name..."
  git tag "$tag_name"
}

push_release() {
  local branch
  branch="$(git branch --show-current)"
  if [[ -z "$branch" ]]; then
    echo "Cannot push from detached HEAD." >&2
    exit 1
  fi

  echo "Pushing $branch and tags to origin..."
  git push origin "$branch" --tags
}

if [[ "$SKIP_NOTES" -eq 0 ]]; then
  draft_notes
fi

if [[ "$NOTES_ONLY" -eq 0 && "$DRY_RUN" -eq 0 ]]; then
  verify_release
fi

if [[ "$DRY_RUN" -eq 0 && "$STAGE" -eq 1 ]]; then
  stage_release_changes
fi

if [[ "$DRY_RUN" -eq 0 && "$COMMIT" -eq 1 ]]; then
  commit_release
fi

if [[ "$DRY_RUN" -eq 0 && "$TAG" -eq 1 ]]; then
  create_release_tag
fi

if [[ "$DRY_RUN" -eq 0 && "$PUSH" -eq 1 ]]; then
  push_release
fi

if [[ "$NOTES_ONLY" -eq 0 && "$DRY_RUN" -eq 0 && "$PUSH" -eq 0 ]]; then
  current_branch="$(git branch --show-current || true)"
  echo
  echo "Release prep complete for v$VERSION."
  echo "Next:"
  if [[ "$STAGE" -eq 0 ]]; then
    echo "  git add -A"
  fi
  if [[ "$COMMIT" -eq 0 ]]; then
    echo "  git commit -m \"chore: prepare v$VERSION release\""
  fi
  if [[ "$TAG" -eq 0 ]]; then
    echo "  git tag v$VERSION"
  fi
  if [[ -n "${current_branch:-}" ]]; then
    echo "  git push origin $current_branch --tags"
  else
    echo "  git push origin <branch> --tags"
  fi
fi
